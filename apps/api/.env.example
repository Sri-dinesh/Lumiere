NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_MIGRATION_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DB?sslmode=require
TEST_DATABASE_URL=postgresql://USER:PASSWORD@TEST_HOST/TEST_DB?sslmode=require
PUBLIC_WEB_ORIGIN=http://localhost:5173
CINEMA_TIMEZONE=Asia/Kolkata
SESSION_TTL_SECONDS=604800
LOG_LEVEL=info
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=AdminSecret123!
SEED_CUSTOMER_EMAIL=customer@example.test
SEED_CUSTOMER_PASSWORD=CustomerSecret123!
SEED_CUSTOMER_2_EMAIL=customer2@example.test
SEED_CUSTOMER_2_PASSWORD=Customer2Secret123!
